logs/archive/

# TTS asset cache
assets/cache/

# Runtime data caches (keep the dirs, ignore contents)
data/models/*
data/projects/*
!data/models/.gitkeep
!data/projects/.gitkeep

# OS
.DS_Store
logs/service.out
logs/service.err
