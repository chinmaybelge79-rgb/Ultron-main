# Ultron — copy this file to .env and fill in your keys.
# Everything is optional; without keys Ultron runs in degraded/offline mode.

# --- OpenRouter (the brain) -------------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY="YOUR_API_KEY"

# --- ElevenLabs (the voice; falls back to macOS "say" when empty) ----
# Get a key at https://elevenlabs.io/api-keys
ELEVENLABS_API_KEY="YOUR_API_KEY"

# --- Optional overrides (defaults shown) ------------------------------
# ULTRON_WAKE_PHRASE=hey ultron,hi ultron,ultron
# ULTRON_WAKE_ACK=Yes sir?
# ULTRON_WHISPER_MODEL=base
# ULTRON_OPENROUTER_MODEL=openai/gpt-4o-mini
# ULTRON_ELEVENLABS_VOICE_ID=kx5PgdDVv8ns0ma9VLxo
# ULTRON_ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# ULTRON_MACOS_SAY_VOICE=
# ULTRON_LLM_TEMPERATURE=0.3
# ULTRON_LLM_MAX_TOKENS=8000
# ULTRON_OLLAMA_URL=http://localhost:11434
# ULTRON_OLLAMA_MODEL=qwen3:14b
# ULTRON_OLLAMA_CODE_MODEL=qwen2.5-coder:14b
# ULTRON_OLLAMA_THINKING=true
# ULTRON_SILENCE_THRESHOLD=0.006
# ULTRON_SILENCE_DURATION=0.9
# ULTRON_COMMAND_TIMEOUT=12
# ULTRON_TOOLS_TIMEOUT=30
# ULTRON_MIC_DEVICE=1
# ULTRON_OUTPUT_DEVICE=1
# ULTRON_LOG_LEVEL=INFO
